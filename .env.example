# LLM Configuration
LLM_MODEL_ID=claude-opus-4-7
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-api-key-here

# Confidence Thresholds
CONFIDENCE_THRESHOLD_DEFAULT=0.70
CONFIDENCE_THRESHOLD_PREDICTION=0.75
CONFIDENCE_THRESHOLD_GUIDELINE=0.70
DATA_COMPLETENESS_THRESHOLD=0.80
MAX_FOLLOWUP_ROUNDS=3
BIAS_SENSITIVITY=medium

# Infrastructure
LOCALSTACK_ENDPOINT=http://localhost:4566
DYNAMODB_TABLE_PREFIX=aig_
S3_DOCUMENT_BUCKET=aig-documents

# Application
CASE_ID_PREFIX=AIG
AUDIT_RETENTION_DAYS=2555

# API
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000
